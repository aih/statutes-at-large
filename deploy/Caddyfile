# One origin, two surfaces (the US Code site's ADR-0010 shape): /app is the
# reader (Astro SSR on Node, frontend:4321) and everything else is FastAPI.
# The citation URL at /us/… redirects browsers to /app and programs to /api/v1.
{
	# Who may name the client. `{client_ip}` below is the forwarded address
	# when the peer is in this range and the peer itself otherwise. The range
	# is the `edge` network deploy/edge/up.sh creates (EDGE_SUBNET), so behind
	# the edge the address it forwards survives this hop, and on the dev stack
	# a workstation (192.168.65.1 on Docker Desktop, a bridge gateway on
	# Linux) is not trusted and its X-Forwarded-For is dropped. Not
	# `private_ranges`: a workstation peer is in a private range too, and would
	# be trusted to forge the address the rate limiter keys on (ADR-0017).
	servers {
		trusted_proxies static 10.83.0.0/24
	}
}

# Google and Bing on the landing pages (ADR-0039). A request matches when it
# comes from an address in Google's or Bing's published crawler ranges, asks
# for one of the pages robots.txt allows them, and carries no query string.
# Such a request skips the crawler 403 and the cookie gate below.
#
# The ranges are `client_ip` lines in /etc/caddy/searchbots/*.caddy, written
# on the box by deploy/searchbot-ranges.sh. 192.0.2.255 is a documentation
# address that no client has, so with no ranges file (the dev stack, CI, or a
# box where the fetch has never succeeded) this matches nothing.
(search_engine_landing) {
	client_ip 192.0.2.255/32
	import /etc/caddy/searchbots/*.caddy
	path / /app /app/ /app/about /app/sources /app/congress /app/congress/ /app/comps /sitemap.xml /favicon.svg /app/_astro/* /app/icons/*
	expression {http.request.uri.query} == ""
}

{$SITE_ADDRESS::8000} {
	encode gzip zstd

	# Googlebot and Bingbot may fetch the landing pages: the home page, About,
	# Sources, the Congress index and the compilations index (ADR-0039).
	# Everything else stays disallowed to them, and to every other agent all
	# of it does. `$` ends a rule at the end of the URL, so a landing page with
	# a query string is still disallowed. The list matches
	# `(search_engine_landing)` above and the sitemap below.
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<ROBOTS
			User-agent: Googlebot
			User-agent: Bingbot
			Allow: /$
			Allow: /app$
			Allow: /app/$
			Allow: /app/about$
			Allow: /app/sources$
			Allow: /app/congress$
			Allow: /app/congress/$
			Allow: /app/comps$
			Allow: /sitemap.xml$
			Allow: /favicon.svg$
			Allow: /app/_astro/
			Allow: /app/icons/
			Disallow: /

			User-agent: *
			Disallow: /

			Sitemap: {$STAT_SITE_ORIGIN:https://statutes.linkedlegislation.org}/sitemap.xml
			ROBOTS 200
	}

	# The landing pages, for Search Console (ADR-0039).
	handle /sitemap.xml {
		header Content-Type "application/xml; charset=utf-8"
		respond <<SITEMAP
			<?xml version="1.0" encoding="UTF-8"?>
			<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
			<url><loc>{$STAT_SITE_ORIGIN:https://statutes.linkedlegislation.org}/app/</loc></url>
			<url><loc>{$STAT_SITE_ORIGIN:https://statutes.linkedlegislation.org}/app/about</loc></url>
			<url><loc>{$STAT_SITE_ORIGIN:https://statutes.linkedlegislation.org}/app/sources</loc></url>
			<url><loc>{$STAT_SITE_ORIGIN:https://statutes.linkedlegislation.org}/app/congress</loc></url>
			<url><loc>{$STAT_SITE_ORIGIN:https://statutes.linkedlegislation.org}/app/comps</loc></url>
			</urlset>
			SITEMAP 200
	}

	# robots.txt says `Disallow: /` to every agent; this block is what it means
	# for an agent that sends a crawler's User-Agent anyway: 403 at the proxy,
	# before the reader renders or the API is called (ADR-0030). The list is the
	# US Code site's (its ADR-0073); the generic `bot`, `crawler` and `spider`
	# markers catch a crawler not named. curl, the watchdog's probes and a script
	# written against /api/v1 match none of it.
	# A search engine on a landing page is the exception (ADR-0039).
	@crawlers {
		header_regexp User-Agent "(?i)(meta-externalagent|meta-webindexer|facebookexternalhit|claudebot|claude-web|gptbot|oai-searchbot|chatgpt-user|perplexitybot|perplexity-user|google-extended|googleother|applebot|amazonbot|bytespider|ccbot|cohere-ai|diffbot|imagesift|omgili|dataforseo|semrush|ahrefs|mj12|dotbot|petalbot|yandex|timpibot|webzio|scrapy|bot[/ ]|[ /(]bot\b|crawler|spider)"
		not {
			import search_engine_landing
		}
	}
	handle @crawlers {
		header Content-Type "text/plain; charset=utf-8"
		respond "This site is closed to automated crawling. See /robots.txt." 403
	}

	# The reader asks for a cookie (ADR-0030, the US Code site's ADR-0088). A
	# request to /app without `stat_h` gets 403 with `Set-Cookie` and one
	# scripted reload; a browser passes once a month, and an HTTP client without
	# a cookie jar gets no page and costs no render. /app/healthz (the
	# watchdog's probe and the container healthcheck) and the static assets are
	# outside it. `GATE_HOST` names the one hostname it applies to; the default,
	# `gate.invalid`, matches no request, so the dev stack and the e2e suite
	# never meet it. docker-compose.prod.yml sets it to the site's hostname.
	@gate {
		host {$GATE_HOST:gate.invalid}
		path /app*
		not path /app/healthz /app/_astro/* /app/icons/*
		not header Cookie *stat_h=*
		# Googlebot and Bingbot keep no cookies (ADR-0039).
		not {
			import search_engine_landing
		}
	}
	handle @gate {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store"
		header Set-Cookie "stat_h=1; Path=/; Max-Age=2592000; SameSite=Lax; Secure; HttpOnly"
		respond <<HTML
			<!doctype html>
			<html lang="en">
			<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>Checking your browser</title>
			<script>
			try {
			  if (!sessionStorage.getItem('stat-gate')) {
			    sessionStorage.setItem('stat-gate', '1');
			    location.reload();
			  }
			} catch (e) {}
			</script>
			</head>
			<body>
			<h1>Checking your browser</h1>
			<p>This page should reload itself. The reader needs cookies enabled; if
			you have them switched off, the pages under /app cannot be served.</p>
			<p>For automated access, use the API at
			<a href="/api/v1/status">/api/v1</a>, documented at
			<a href="/docs">/docs</a>. This site is closed to crawling: see
			<a href="/robots.txt">/robots.txt</a>.</p>
			</body>
			</html>
			HTML 403
	}

	# The reader. `header_up X-Forwarded-For {client_ip}` overwrites the header
	# (uvicorn and Astro's Node adapter both read the leftmost value under
	# `--forwarded-allow-ips *`). `{client_ip}` is the same line on the dev
	# stack and behind the edge: from a trusted peer (the edge, which has
	# already overwritten the header with the real client) it is the forwarded
	# address; from anyone else it is the peer. The reader reads it as
	# `Astro.clientAddress` and forwards it on its own API calls, so `cite` and
	# `cited-by` are limited per reader and not per frontend container.
	handle /app* {
		reverse_proxy frontend:4321 {
			header_up X-Forwarded-For {client_ip}
			lb_try_duration 25s
			lb_try_interval 250ms
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	# `lb_try_duration` (both blocks): while a deploy recreates a backend its
	# name does not resolve, and a request retries the dial every 250ms for up
	# to 25s instead of answering 502 (the US Code site's ADR-0092). Under the
	# edge's own 30s `response_header_timeout`.
	#
	# Everything else is FastAPI: /api/v1, the citation redirector at /us/…,
	# /health, and the OpenAPI docs. The same overwrite, so the rate limiter
	# keys on the client the trusted hop named, or on the peer.
	handle {
		reverse_proxy api:8001 {
			header_up X-Forwarded-For {client_ip}
			lb_try_duration 25s
			lb_try_interval 250ms
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	header {
		?Strict-Transport-Security "max-age=31536000; includeSubDomains"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?X-Frame-Options "DENY"
	}

	log {
		output stdout
		format console
	}
}
