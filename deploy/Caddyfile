# One origin, two surfaces (the US Code site's ADR-0010 shape): /app is the
# reader (Astro SSR on Node, frontend:4321) and everything else is FastAPI.
# The citation URL at /us/… redirects browsers to /app and programs to /api/v1.
{
	servers {
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS::8000} {
	encode gzip zstd

	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<ROBOTS
			User-agent: *
			Disallow: /
			ROBOTS 200
	}

	# The reader. The same X-Forwarded-For overwrite as the API block, so a
	# limiter in front of the reader keys on the real peer.
	handle /app* {
		reverse_proxy frontend:4321 {
			header_up X-Forwarded-For {remote_host}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	# Everything else is FastAPI: /api/v1, the citation redirector at /us/…,
	# /health, and the OpenAPI docs. `header_up X-Forwarded-For {remote_host}`
	# overwrites the header, so the rate limiter keys on the real peer.
	handle {
		reverse_proxy api:8001 {
			header_up X-Forwarded-For {remote_host}
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	header {
		?Strict-Transport-Security "max-age=31536000; includeSubDomains"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?X-Frame-Options "DENY"
	}

	log {
		output stdout
		format console
	}
}
