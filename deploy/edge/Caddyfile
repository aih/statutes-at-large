# The edge (docs/plans/2026-09-08-deployment-plan.md, section 1): TLS for
# the four hostnames, each handed to its site's own Caddy over the `edge` network.
#
# The site addresses come from the environment with the production defaults;
# a bare hostname means automatic HTTPS. The rehearsal sets plain-HTTP
# addresses with a port (`http://statutes.localhost:8020`).
#
# No `trusted_proxies`: the peer is the internet. `header_up X-Forwarded-For
# {remote_host}` overwrites the header with the real peer, and the inner
# proxies trust this hop (their `trusted_proxies static 10.83.0.0/24`, the
# network deploy/edge/up.sh creates) and pass that address on. `Host` goes
# through unchanged so each inner site block matches its own hostname.

{$USCODE_SITE_ADDRESS:uscode.linkedlegislation.org} {
	reverse_proxy uscode-proxy:8000 {
		header_up X-Forwarded-For {remote_host}
		header_up Host {host}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}

	log {
		output stdout
		format console
	}
}

{$STATUTES_SITE_ADDRESS:statutes.linkedlegislation.org} {
	reverse_proxy statutes-proxy:8000 {
		header_up X-Forwarded-For {remote_host}
		header_up Host {host}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}

	log {
		output stdout
		format console
	}
}

# reintro.linkedlegislation.org, the reintroductions-us compose project
# (that repository's docs/deploy.md). A bill's PDF is rendered on request in
# up to about 20 s of CPU, 60 s at the box's baseline; the header timeout is 120 s.
{$REINTRO_SITE_ADDRESS:reintro.linkedlegislation.org} {
	reverse_proxy reintro-proxy:8000 {
		header_up X-Forwarded-For {remote_host}
		header_up Host {host}
		transport http {
			dial_timeout 5s
			response_header_timeout 120s
		}
	}

	log {
		output stdout
		format console
	}
}

# codification.linkedlegislation.org, the Codification Bill Reader: static
# files in one Caddy container, run by aih/codification-bills
# deploy/deploy-on-box.sh as `codification-reader` with the network alias
# `codification-proxy`.
{$CODIFICATION_SITE_ADDRESS:codification.linkedlegislation.org} {
	reverse_proxy codification-proxy:8000 {
		header_up X-Forwarded-For {remote_host}
		header_up Host {host}
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}

	log {
		output stdout
		format console
	}
}
