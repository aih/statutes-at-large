# Postgres. docker compose publishes the dev database on 5434 (5432 and 5433
# are taken by sibling projects on the same machine).
DATABASE_URL=postgresql+psycopg://statutes:statutes@localhost:5434/statutes

# GovInfo API key for the COMPS poller (https://api.govinfo.gov/docs/).
# Never written into source or committed; ingest reads it from the environment.
GOVINFO_API_KEY=

# The public origin, used to build absolute URLs in `alternatives`.
SITE_ORIGIN=https://statutes.linkedlegislation.org
USCODE_ORIGIN=https://uscode.linkedlegislation.org

# The search cluster (ADR-0023). The dev stack's own OpenSearch, on host port
# 9201 (9200 is the US Code site's dev cluster on this machine); on the box
# this is the US Code site's cluster, reached through `search-relay`. The API
# and `python -m ingest` read these lines from this file
# (`storage.search.SearchSettings`); a variable set in the environment wins.
# SEARCH_PASSWORD is also the dev cluster's admin password
# (docker-compose.yml) and must not contain "admin".
SEARCH_URL=https://localhost:9201
SEARCH_PASSWORD=
SEARCH_VERIFY_CERTS=false

# Uncomment to make `python -m ingest reindex-search` a no-op, the only thing
# in `ingest/` that reaches a cluster. `make test` reads no .env for these.
# DISABLE_SEARCH_SYNC=1
