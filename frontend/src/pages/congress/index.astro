---
/**
 * `/app/congress` — Acts by Congress from the 1st Congress on.
 *
 * Overview page listing all loaded Congresses with summary facts, a timeline
 * bar chart of laws enacted per Congress, and links to each Congress's laws,
 * Statute Compilations, and US Code classification tables.
 */
import Note from "../../components/Note.astro";
import Base from "../../layouts/Base.astro";
import { fetchCongresses } from "../../lib/api";
import { REVALIDATE } from "../../lib/cache";
import { clientAddressOf } from "../../lib/params";
import { APP, appHref, congressHref, uscodeHref } from "../../lib/url";

Astro.response.headers.set("Cache-Control", REVALIDATE);

const answer = await fetchCongresses({ clientAddress: clientAddressOf(Astro) });
const overview = answer.body;
const congresses = overview.congresses;

const number = (val: number) => val.toLocaleString("en-US");

// Compute chart dimensions
const chartWidth = 800;
const chartHeight = 220;
const padLeft = 45;
const padRight = 15;
const padTop = 25;
const padBottom = 35;
const plotWidth = chartWidth - padLeft - padRight;
const plotHeight = chartHeight - padTop - padBottom;

const maxLaws = Math.max(1, ...congresses.map((c) => c.total_laws));
const n = congresses.length;
const slotWidth = n > 0 ? plotWidth / n : plotWidth;
const barWidth = Math.max(8, Math.min(36, slotWidth - 4));

const totalCiting = congresses.reduce((acc, c) => acc + c.citing_sections_count, 0);
---

<Base
  title="Acts by Congress — Statutes at Large"
  crumbs={[{ label: "Home", href: `${APP}/` }]}
  current="Congresses"
>
  <h1 class="doc-title">Acts by Congress</h1>
  <p class="lede">
    Historical data analysis of Acts enacted by Congress from the 1st Congress on,
    cross-referenced to the United States Code and OLRC classification tables.
  </p>

  <Note note={overview.note} />

  <h2 class="group">Summary facts</h2>
  <dl class="facts status">
    <dt>Congresses loaded</dt>
    <dd>{number(overview.total_congresses)}</dd>
    <dt>Total laws</dt>
    <dd>
      {number(overview.total_laws)} ({number(overview.total_public_laws)} public, {number(overview.total_private_laws)} private, {number(overview.total_chapter_acts)} chapter acts)
    </dd>
    <dt>Total sections</dt>
    <dd>{number(overview.total_sections)}</dd>
    <dt>Statute Compilations</dt>
    <dd>{number(overview.total_compilations)}</dd>
    <dt>US Code citing sections</dt>
    <dd>{number(totalCiting)} sections cite laws across these Congresses</dd>
  </dl>

  <h2 class="group" id="timeline">Laws enacted per Congress</h2>
  <div class="timeline-container">
    <div class="timeline-legend">
      <span class="legend-item"><span class="legend-swatch swatch--pl"></span> Public Laws</span>
      <span class="legend-item"><span class="legend-swatch swatch--pvtl"></span> Private Laws</span>
      <span class="legend-item"><span class="legend-swatch swatch--act"></span> Chapter Acts</span>
    </div>

    <svg
      role="img"
      viewBox={`0 0 ${chartWidth} ${chartHeight}`}
      class="congress-chart"
      aria-labelledby="chart-title chart-desc"
    >
      <title id="chart-title">Laws enacted per Congress</title>
      <desc id="chart-desc">
        Bar chart displaying laws enacted per Congress, distinguishing public laws, private laws, and chapter acts.
      </desc>

      {/* Y-axis guidelines */}
      <line x1={padLeft} y1={padTop} x2={chartWidth - padRight} y2={padTop} stroke="#e0e0e0" stroke-dasharray="2 2" />
      <line x1={padLeft} y1={padTop + plotHeight / 2} x2={chartWidth - padRight} y2={padTop + plotHeight / 2} stroke="#e0e0e0" stroke-dasharray="2 2" />
      <line x1={padLeft} y1={padTop + plotHeight} x2={chartWidth - padRight} y2={padTop + plotHeight} stroke="#71767a" />

      {/* Y-axis labels */}
      <text x={padLeft - 8} y={padTop + 4} text-anchor="end" font-size="11" fill="#71767a">{maxLaws}</text>
      <text x={padLeft - 8} y={padTop + plotHeight / 2 + 4} text-anchor="end" font-size="11" fill="#71767a">{Math.round(maxLaws / 2)}</text>
      <text x={padLeft - 8} y={padTop + plotHeight + 4} text-anchor="end" font-size="11" fill="#71767a">0</text>

      {/* Bars */}
      {congresses.map((c, i) => {
        const xCenter = padLeft + (i + 0.5) * slotWidth;
        const x = xCenter - barWidth / 2;

        const hAct = (c.chapter_acts / maxLaws) * plotHeight;
        const hPvtl = (c.private_laws / maxLaws) * plotHeight;
        const hPl = (c.public_laws / maxLaws) * plotHeight;

        const yBase = padTop + plotHeight;
        const yPl = yBase - hPl;
        const yPvtl = yPl - hPvtl;
        const yAct = yPvtl - hAct;

        const tip = `${c.ordinal} Congress (${c.start_year}–${c.end_year}): ${c.total_laws} laws (${c.public_laws} public, ${c.private_laws} private, ${c.chapter_acts} chapter acts)`;

        return (
          <a href={congressHref(c.congress)} class="chart-bar-group" tabindex="0">
            <title>{tip}</title>
            {hPl > 0 && <rect x={x} y={yPl} width={barWidth} height={hPl} fill="#1a4480" />}
            {hPvtl > 0 && <rect x={x} y={yPvtl} width={barWidth} height={hPvtl} fill="#2670c4" />}
            {hAct > 0 && <rect x={x} y={yAct} width={barWidth} height={hAct} fill="#565c65" />}
            <text
              x={xCenter}
              y={yBase + 16}
              text-anchor="middle"
              font-size="11"
              fill="#1b1b1b"
              font-weight="bold"
            >
              {c.congress}
            </text>
          </a>
        );
      })}
    </svg>
  </div>

  <h2 class="group" id="table">All Congresses</h2>
  <div class="uslm-tablewrap">
    <table class="usa-table usa-table--borderless congresses-table">
      <thead>
        <tr>
          <th scope="col">Congress</th>
          <th scope="col">Volumes</th>
          <th scope="col">Laws</th>
          <th scope="col">Sections</th>
          <th scope="col">Compilations</th>
          <th scope="col">US Code Citations</th>
          <th scope="col">Classification Tables</th>
        </tr>
      </thead>
      <tbody>
        {congresses.map((c) => (
          <tr>
            <td>
              <a href={congressHref(c.congress)} class="congress-link">
                <strong>{c.ordinal} Congress</strong>
              </a>
              <br />
              <span class="doc-meta">{c.start_year}–{c.end_year}</span>
            </td>
            <td>
              {c.volumes.length > 0
                ? c.volumes.map((v) => (
                    <a href={appHref(`/us/stat/${v}/1`)} class="vol-tag">
                      Vol. {v}
                    </a>
                  ))
                : <span class="doc-meta">—</span>}
            </td>
            <td>
              <strong>{number(c.total_laws)}</strong>
              <br />
              <span class="doc-meta">
                {c.public_laws > 0 && `${c.public_laws} pl`}
                {c.private_laws > 0 && ` · ${c.private_laws} pvtl`}
                {c.chapter_acts > 0 && ` · ${c.chapter_acts} act`}
                {c.total_laws === 0 && "none"}
              </span>
            </td>
            <td>{number(c.section_count)}</td>
            <td>
              {c.compilations_count > 0 ? (
                <a href={congressHref(c.congress, { has_comp: "true" })}>
                  {number(c.compilations_count)}
                </a>
              ) : (
                <span class="doc-meta">0</span>
              )}
            </td>
            <td>
              {c.cited_laws_count > 0 ? (
                <a href={congressHref(c.congress, { cited: "true" })}>
                  {number(c.cited_laws_count)} {c.cited_laws_count === 1 ? "law" : "laws"} cited
                </a>
              ) : (
                <span class="doc-meta">0</span>
              )}
              {c.citing_sections_count > 0 && (
                <span class="doc-meta">
                  <br />
                  ({number(c.citing_sections_count)} citing {c.citing_sections_count === 1 ? "section" : "sections"})
                </span>
              )}
            </td>
            <td>
              {c.uscode_classification_urls.length > 0 ? (
                <ul class="classification-links">
                  {c.uscode_classification_urls.map((u) => (
                    <li>
                      <a href={u.url} target="_blank" rel="noopener noreferrer">
                        Session {u.session}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <span class="doc-meta">—</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>

<style>
  .timeline-container {
    background: #f0f4f8;
    border: 1px solid #d9e2ec;
    border-radius: 4px;
    padding: 1rem 1rem 0.5rem;
    margin-bottom: 2rem;
  }
  .timeline-legend {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    color: #486581;
  }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .legend-swatch {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 2px;
  }
  .swatch--pl {
    background-color: #1a4480;
  }
  .swatch--pvtl {
    background-color: #2670c4;
  }
  .swatch--act {
    background-color: #565c65;
  }
  .congress-chart {
    width: 100%;
    height: auto;
    display: block;
  }
  .chart-bar-group {
    cursor: pointer;
    transition: opacity 0.15s ease-in-out;
  }
  .chart-bar-group:hover,
  .chart-bar-group:focus {
    opacity: 0.8;
    outline: none;
  }
  .vol-tag {
    display: inline-block;
    margin-right: 0.35rem;
    margin-bottom: 0.25rem;
    font-size: 0.875rem;
  }
  .congresses-table {
    width: 100%;
    margin-top: 1rem;
  }
  .congress-link {
    font-size: 1.05rem;
  }
  .classification-links {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
  }
  .classification-links li {
    margin-bottom: 0.2rem;
  }
</style>
