---
/**
 * `/app/goto?q=`: `GET /api/v1/cite?q=`, then one of three outcomes.
 * `exists: true` is a 307 to `/app{identifier}`; `kind: "usc"` is a 307 to
 * `url`; `exists: false` prints the `note` with status 404. A 422 — text
 * `cite` cannot read as a citation — is a 307 to `/app/search?q=` with the
 * query carried over: a citation still wins over a search, but text that is
 * not one is words rather than a dead end. No JavaScript; failures are
 * `no-store`.
 */
import CiteBox from "../components/CiteBox.astro";
import Base from "../layouts/Base.astro";
import { ApiError, fetchCite } from "../lib/api";
import { NO_STORE } from "../lib/cache";
import type { Cite, Link } from "../lib/types";
import { clientAddressOf } from "../lib/params";
import { APP, appHref, searchHref } from "../lib/url";

const query = (Astro.url.searchParams.get("q") ?? "").trim();

let found: Cite | null = null;
let failure: { status: number; detail: string; retryAfter: string | null } | null = null;
if (query) {
  try {
    found = await fetchCite(query, { clientAddress: clientAddressOf(Astro) });
  } catch (error) {
    if (error instanceof ApiError && error.status === 422) {
      return Astro.redirect(searchHref(query), 307);
    }
    if (error instanceof ApiError) {
      failure = { status: error.status, detail: error.detail, retryAfter: error.retryAfter };
    } else {
      failure = { status: 502, detail: `The API did not answer: ${(error as Error).message}`, retryAfter: null };
    }
  }
}

/** `exists: true` goes to this site; `kind: "usc"` to the US Code site. */
const destination: string | null =
  found?.exists === true
    ? appHref(found.identifier)
    : found?.kind === "usc" && found.url
      ? encodeURI(found.url)
      : null;
if (destination) {
  return Astro.redirect(destination, 307);
}

Astro.response.headers.set("Cache-Control", NO_STORE);
if (failure) {
  Astro.response.status = failure.status;
  if (failure.retryAfter) Astro.response.headers.set("Retry-After", failure.retryAfter);
} else if (found) {
  Astro.response.status = 404;
}

const crumbs: Link[] = [{ href: `${APP}/`, label: "Home" }];
const title = query ? `${query} — Statutes at Large` : "Go to a citation — Statutes at Large";
---

<Base title={title} crumbs={crumbs} current="Go to a citation" query={query}>
  <h1 class="doc-title">Go to a citation</h1>

  {
    failure && (
      <div class="usa-alert usa-alert--error" role="alert">
        <div class="usa-alert__body">
          <h2 class="usa-alert__heading">{failure.status}</h2>
          <p class="usa-alert__text">{failure.detail}</p>
        </div>
      </div>
    )
  }

  {
    found && (
      <div class="usa-alert usa-alert--warning" role="status">
        <div class="usa-alert__body">
          <h2 class="usa-alert__heading">{found.label}</h2>
          <p class="usa-alert__text">{found.note}</p>
          {found.message && <p class="usa-alert__text">{found.message}</p>}
          <p class="usa-alert__text">
            Identifier: <code>{found.identifier}</code>
          </p>
        </div>
      </div>
    )
  }

  <CiteBox id="goto-q" query={query} />
</Base>
