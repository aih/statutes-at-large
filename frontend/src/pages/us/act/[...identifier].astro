---
import UnitPage from "../../../components/UnitPage.astro";
import { clientAddressOf, identifierParam } from "../../../lib/params";
import { applyResponse, loadUnitPage } from "../../../lib/unitpage";

const model = await loadUnitPage(identifierParam("/us/act", Astro.params.identifier), {
  clientAddress: clientAddressOf(Astro),
});
applyResponse(Astro.response, model);
---

<UnitPage model={model} />
