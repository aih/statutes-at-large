---
/** A table of contents, nested by level, every entry linked to `/app{identifier}`. */
import type { TocNode } from "../lib/toc";
import { unitLabel } from "../lib/toc";
import { appHref } from "../lib/url";

interface Props {
  nodes: TocNode[];
  query?: Record<string, string | null | undefined>;
}

const { nodes, query } = Astro.props;
---

{
  nodes.length > 0 && (
    <ul class="toc">
      {nodes.map((node) => (
        <li>
          <a href={appHref(node.entry.identifier, query)}>
            <span class="toc__num">{unitLabel(node.entry.level, node.entry.num)}</span>
            <span class="toc__heading">{node.entry.heading}</span>
          </a>
          {node.children.length > 0 && <Astro.self nodes={node.children} query={query} />}
        </li>
      ))}
    </ul>
  )
}
