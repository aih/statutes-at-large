---
/** Previous and next section: the unit label, then the heading, in small caps
 * when `smallCapsClass` says so. */
import type { Link } from "../lib/types";
import { smallCapsClass } from "../lib/toc";

type Neighbor = Link & { heading?: string | null };

interface Props {
  previous: Neighbor | null;
  next: Neighbor | null;
}

const { previous, next } = Astro.props;
---

{
  (previous || next) && (
    <nav class="neighbors" aria-label="Previous and next section">
      <div>
        {previous && (
          <a href={previous.href} rel="prev">
            <span class="neighbors__dir">Previous</span>
            <span>
              {previous.label}
              {previous.label && previous.heading && " "}
              {previous.heading && <span class={smallCapsClass(previous.heading)}>{previous.heading}</span>}
            </span>
          </a>
        )}
      </div>
      <div class="neighbors__next">
        {next && (
          <a href={next.href} rel="next">
            <span class="neighbors__dir">Next</span>
            <span>
              {next.label}
              {next.label && next.heading && " "}
              {next.heading && <span class={smallCapsClass(next.heading)}>{next.heading}</span>}
            </span>
          </a>
        )}
      </div>
    </nav>
  )
}
