---
/** The citation box: a GET form to `/app/goto` with one field, `q`. */
import { gotoHref } from "../lib/url";

interface Props {
  query?: string | null;
  id?: string;
}

const { query = null, id = "cite-q" } = Astro.props;
---

<form class="usa-search" method="get" action={gotoHref()} role="search">
  <label class="usa-sr-only" for={id}>Citation</label>
  <input
    class="usa-input"
    id={id}
    type="search"
    name="q"
    value={query ?? ""}
    placeholder="Citation or words"
  />
  <button class="usa-button" type="submit"><span class="usa-search__submit-text">Go</span></button>
</form>
